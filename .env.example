# CodeMind AI Environment Configuration
# Copy values into .env in root or service directories. Never commit secrets.

NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Core database and queue
DATABASE_URL=postgresql://codemind:codemind_dev_password@localhost:5432/codemind
REDIS_URL=redis://localhost:6379

# Service security
JWT_ACCESS_SECRET=dev_jwt_access_secret_codemind_change_in_production_32chars!
INTERNAL_SERVICE_TOKEN=dev_internal_service_token_codemind_secret_key_64bit

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_PROVIDER=mock
AI_MODEL=mock-agent-v1
AI_API_KEY=

# Processing limits
MAX_SOURCE_BYTES=500000
MAX_FILES_PER_REVIEW=30
REVIEW_TIMEOUT_SECONDS=300
AGENT_TIMEOUT_SECONDS=90
MAX_AGENT_RETRIES=1
LOG_LEVEL=info

# GitHub Integration (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
